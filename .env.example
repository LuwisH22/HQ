# ---------------------------------------------------------------------------
# LFG HQ — environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored.
#
# SAFE FOR THE FRONTEND (bundled into the app, visible to anyone who has it):
#   Every variable prefixed with VITE_. These are public by design; the anon key
#   is only useful in combination with Row Level Security, which is why RLS is
#   mandatory on every table in this project.
#
# SERVER-ONLY (NEVER prefix with VITE_, never import from src/):
#   SUPABASE_SERVICE_ROLE_KEY and friends. They live in Supabase Edge Function
#   secrets / your CI secret store only.
# ---------------------------------------------------------------------------

# --- Frontend (public) -----------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Public by design — protected by RLS.
VITE_SUPABASE_ANON_KEY=

# Displayed in the UI + used for deep links. Optional.
VITE_APP_NAME=LFG HQ

# --- Development only ------------------------------------------------------

# Demo mode lets the app run with no Supabase project, using a local sample
# dataset, so Phase 1 can be exercised offline. It is available ONLY in a dev
# build: production builds compile the check to a constant false and alias the
# demo implementation out of the bundle entirely.
#
# Leave unset to keep it available in `npm run dev` / `npm run desktop:dev`.
# Set to false once real credentials are in place and you want the sign-in
# screen to offer nothing but the real thing.
# VITE_DEMO_MODE=false

# Where invite/password-reset emails should redirect back to.
# Desktop builds use the lfghq:// deep link; web/PWA uses this URL.
VITE_PUBLIC_SITE_URL=http://localhost:1420

# --- Server only — DO NOT add a VITE_ prefix and DO NOT read from src/ ------
# Used by the Supabase CLI and by Edge Functions (set via `supabase secrets set`).

# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=

# --- Voice (Phase 4) — Edge Function secrets, NEVER a VITE_ prefix ---------
#
# The API secret signs a LiveKit access token for any room with any grant, so
# it lives in Supabase Edge Function secrets and nowhere else:
#
#   supabase secrets set LIVEKIT_URL=wss://<project>.livekit.cloud
#   supabase secrets set LIVEKIT_API_KEY=...
#   supabase secrets set LIVEKIT_API_SECRET=...
#
# The client never reads any of these: `voice-token` returns the URL along
# with the token it mints. A self-hosted server also needs its host adding to
# `connect-src` in src-tauri/tauri.conf.json, which currently allows
# *.livekit.cloud.
#
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
